<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".HelpActivity">

    <!-- ScrollView para que no se corte en pantallas pequeñas -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Tarjeta Principal con tono Granate/Vino Oscuro -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#2A0813"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"

                    android:padding="20dp">

                    <!-- Logo PokéAPI -->
                    <ImageView
                        android:id="@+id/imgPokeApiLogo"
                        android:layout_width="260dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/pokeapi"
                        android:contentDescription="PokéAPI Logo"
                        android:scaleType="fitCenter" />

                    <!-- Descripción PokéAPI -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Usando el proyecto OpenSource de PokéApi para obtener los datos de los diferentes Pokémon"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <!-- Logo Kotlin -->
                    <ImageView
                        android:id="@+id/imgKotlinLogo"
                        android:layout_width="180dp"
                        android:layout_height="60dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/kotlin"
                        android:contentDescription="Kotlin Logo"
                        android:scaleType="fitCenter" />

                    <!-- Descripción de Tecnología -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Desarrollada en Android Studio, hecha con Kotlin nativo y XML para las vistas."
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <!-- Título Desarrolladores -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Desarrolladores"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Lista de Desarrolladores -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <!-- Desarrollador 1: Luis Cartagena -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/imgDev1"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/roggen1"
                                android:contentDescription="Avatar Luis Cartagena" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Luis Cartagena - LuisArteaga02"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Desarrollador 2: Daniel Lino -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/imgDev2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/dani"
                                android:contentDescription="Avatar Daniel Lino" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Daniel Lino - DFquack"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Desarrollador 3: Luis Ortiz -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/imgDev3"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/luis"
                                android:contentDescription="Avatar Luis Ortiz" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Luis Ortiz - luhotz"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="#1A1921"
                android:drawablePadding="8dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Back"
                android:textColor="@color/white"
                android:textSize="16sp"

                android:textStyle="bold"
                app:drawableStartCompat="@drawable/back_btn"
                app:drawableTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>