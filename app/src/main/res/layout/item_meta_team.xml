<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/secondary_variant"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header con Nombre del equipo y Botón Guardar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvTeamUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Vedant Max"
                android:textColor="@color/on_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <!-- NUEVO: Botón para guardar este equipo en el perfil del usuario -->
        </LinearLayout>

        <!-- Contenedor horizontal para los 6 Pokémon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/imgP1" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon1"
                android:scaleType="fitCenter" android:background="#0B0912"/>
            <ImageView android:id="@+id/imgP2" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon2"
                android:scaleType="fitCenter" android:background="#0B0912"/>
            <ImageView android:id="@+id/imgP3" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon3"
                android:scaleType="fitCenter" android:background="#0B0912"/>
            <ImageView android:id="@+id/imgP4" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon4"
                android:scaleType="fitCenter" android:background="#0B0912"/>
            <ImageView android:id="@+id/imgP5" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon5"
                android:scaleType="fitCenter" android:background="#0B0912"/>
            <ImageView android:id="@+id/imgP6" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon6"
                android:scaleType="fitCenter" android:background="#0B0912"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <!-- Botón Publicar (Para subir a la comunidad) -->
            <TextView
                android:id="@+id/btnPublishTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="#3B82F6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_publish"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Botón Editar -->
            <TextView
                android:id="@+id/btnEditTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="#4CAF50"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/team_button_edit"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Botón Guardar (Se usa en MainActivity) -->
            <TextView
                android:id="@+id/btnSaveTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="@color/primary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_save"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Botón Eliminar -->
            <TextView
                android:id="@+id/btnDeleteTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="#D32F2F"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/team_button_delete"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>