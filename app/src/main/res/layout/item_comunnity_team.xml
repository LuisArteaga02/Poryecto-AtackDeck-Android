<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#1A1921"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cabecera: Info del equipo y Votos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Título y Autor -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCommunityTeamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Rain Dance Meta"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCommunityAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Subido por yugoaderm"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Controles de Votación estilo Reddit -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp">

                <!-- Flecha Arriba (Upvote) -->
                <ImageView
                    android:id="@+id/btnUpvote"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/team_description_upvote"
                    android:padding="4dp"
                    android:src="@android:drawable/arrow_up_float"
                    app:tint="#9CA3AF" />

                <!-- Puntuación (Score) -->
                <TextView
                    android:id="@+id/tvTeamScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    tools:text="125"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Flecha Abajo (Downvote) -->
                <ImageView
                    android:id="@+id/btnDownvote"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/team_description_downvote"
                    android:padding="4dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#9CA3AF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Descripción del equipo -->
        <TextView
            android:id="@+id/tvCommunityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="Un equipo basado en clima lluvioso para potenciar a los tipo agua y evitar debilidades de fuego. Usa a Pelipper de líder."
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Contenedor de los 6 Pokémon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/imgP1" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon1"
                android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/imgP2" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon2"
                android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/imgP3" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon3"
                android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/imgP4" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon4"
                android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/imgP5" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon5"
                android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/imgP6" android:layout_width="38dp" android:layout_height="38dp" android:layout_margin="2dp"
                android:contentDescription="@string/team_description_pokemon6"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>